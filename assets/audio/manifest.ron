// KINGDOMS audio manifest. Files are relative to assets/audio/. Missing files are skipped silently.
// Channels: Music, Ambience, Effects, Ui, Voice. A file is found by its stem in its folder with any
// supported extension (.ogg, .mp3, .wav, .flac; the named one preferred), see README.md here.
// Voice lines: `text` holds the exact German words to speak (one per file), `description` the delivery.
(
    music: [
        (id: "menu_theme", file: "music/menu_theme.ogg", moods: [Menu], volume: 0.9,
         description: "Main menu theme: majestic, hopeful medieval orchestral piece with lute, strings, soft choir, slow build"),
        (id: "peaceful_dawn", file: "music/peaceful_dawn.ogg", moods: [Peaceful], volume: 0.8,
         description: "Calm morning in a small village: lute, recorder, harp, gentle and warm"),
        (id: "peaceful_fields", file: "music/peaceful_fields.ogg", moods: [Peaceful], volume: 0.8,
         description: "Pastoral spring/summer music: hurdy-gurdy, flute, light percussion, carefree"),
        (id: "peaceful_village", file: "music/peaceful_village.ogg", moods: [Peaceful], volume: 0.8,
         description: "Bustling-but-relaxed village life: fiddle, lute, frame drum, dance-like 6/8"),
        (id: "peaceful_river", file: "music/peaceful_river.ogg", moods: [Peaceful, Night], volume: 0.8,
         description: "Reflective, flowing melody: harp, cello, soft recorder"),
        (id: "prosperous_city", file: "music/prosperous_city.ogg", moods: [Prosperous], volume: 0.85,
         description: "Thriving medieval town: brass, strings, festive percussion, proud and uplifting"),
        (id: "prosperous_market", file: "music/prosperous_market.ogg", moods: [Prosperous, Peaceful], volume: 0.8,
         description: "Busy market day: bagpipe, fiddle, tambourine, lively folk dance"),
        (id: "royal_court", file: "music/royal_court.ogg", moods: [Prosperous], volume: 0.8,
         description: "Regal court music: harpsichord-like plucked strings, recorders, stately dance"),
        (id: "winter_hearth", file: "music/winter_hearth.ogg", moods: [Winter], volume: 0.8,
         description: "Cold winter, warm hearth: slow strings, celesta-like bells, solo voice humming"),
        (id: "winter_snowfall", file: "music/winter_snowfall.ogg", moods: [Winter, Night], volume: 0.75,
         description: "Quiet snowfall: sparse harp and low drone, melancholic but hopeful"),
        (id: "night_watch", file: "music/night_watch.ogg", moods: [Night], volume: 0.7,
         description: "Night over the town: soft low strings, distant flute, very calm"),
        (id: "tension_unrest", file: "music/tension_unrest.ogg", moods: [Tense], volume: 0.85,
         description: "Unrest and hardship: minor key, low strings, frame drum heartbeat, uneasy"),
        (id: "tension_famine", file: "music/tension_famine.ogg", moods: [Tense], volume: 0.8,
         description: "Shortage and hunger: sparse, mournful fiddle and drone"),
        (id: "war_march", file: "music/war_march.ogg", moods: [War], volume: 0.9,
         description: "Armies marching: war drums, horns, low male choir, driving rhythm"),
        (id: "war_siege", file: "music/war_siege.ogg", moods: [War], volume: 0.9,
         description: "Siege battle: intense percussion, brass stabs, dramatic choir"),
    ],
    sounds: {
        // ---------------- Ambience (looping) ----------------
        "amb_birds_day": (files: ["ambience/birds_day.ogg"], channel: Ambience, volume: 0.6,
            description: "Looping daytime countryside: songbirds, light breeze"),
        "amb_night": (files: ["ambience/night_crickets.ogg"], channel: Ambience, volume: 0.55,
            description: "Looping night: crickets, distant owl, very calm"),
        "amb_wind": (files: ["ambience/wind_meadow.ogg"], channel: Ambience, volume: 0.45,
            description: "Looping soft wind over meadows"),
        "amb_winter_wind": (files: ["ambience/winter_wind.ogg"], channel: Ambience, volume: 0.5,
            description: "Looping cold winter wind, occasional gusts"),
        "amb_river": (files: ["ambience/river.ogg"], channel: Ambience, volume: 0.5,
            description: "Looping gentle river stream"),
        "amb_sea": (files: ["ambience/sea_waves.ogg"], channel: Ambience, volume: 0.5,
            description: "Looping calm sea waves on a shore"),
        "amb_forest": (files: ["ambience/forest.ogg"], channel: Ambience, volume: 0.5,
            description: "Looping forest: leaves rustling, woodpecker, birds"),
        "amb_rain": (files: ["ambience/rain.ogg"], channel: Ambience, volume: 0.6,
            description: "Looping steady rain"),
        "amb_storm": (files: ["ambience/storm.ogg"], channel: Ambience, volume: 0.65,
            description: "Looping heavy storm with rain and distant thunder"),
        "amb_town": (files: ["ambience/town_bustle.ogg"], channel: Ambience, volume: 0.5,
            description: "Looping medieval town bustle: footsteps, distant voices, carts, no modern sounds"),
        "amb_market": (files: ["ambience/market_crowd.ogg"], channel: Ambience, volume: 0.45,
            description: "Looping market crowd murmur with merchants calling (unintelligible)"),
        // ---------------- Building & construction ----------------
        "sfx_place_building": (files: ["sfx/place_building.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 80,
            description: "Short wooden thump + rope creak when placing a building"),
        "sfx_construction": (files: ["sfx/construction_1.ogg", "sfx/construction_2.ogg"], channel: Effects, volume: 0.5, max_instances: 3, pitch_variation: 0.06,
            description: "Hammering on wood and sawing at a construction site (2 s)"),
        "sfx_construction_complete": (files: ["sfx/construction_complete.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 500,
            description: "Satisfying completion: final hammer strike + short cheerful chime"),
        "sfx_demolish": (files: ["sfx/demolish.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 150,
            description: "Wooden structure collapsing, planks and dust"),
        "sfx_road_place": (files: ["sfx/road_place.ogg"], channel: Effects, volume: 0.6, cooldown_ms: 60, pitch_variation: 0.05,
            description: "Shovel into gravel / stones being laid"),
        "sfx_upgrade": (files: ["sfx/upgrade.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 300,
            description: "Building upgraded: rising chime with a soft brass note"),
        "sfx_downgrade": (files: ["sfx/downgrade.ogg"], channel: Effects, volume: 0.7, cooldown_ms: 1000,
            description: "Haus steigt ab: fallende, gedämpfte Glockenfolge, leicht wehmütig"),
        "sfx_road_remove": (files: ["sfx/road_remove.ogg"], channel: Effects, volume: 0.6, cooldown_ms: 80, pitch_variation: 0.05,
            description: "Straße wird entfernt: Spitzhacke lockert Steine, Schotter rieselt"),
        "sfx_tree_plant": (files: ["sfx/tree_plant.ogg"], channel: Effects, volume: 0.4, max_instances: 1, pitch_variation: 0.08,
            description: "Setzling wird gepflanzt: Spaten sticht in Erde, Erde wird angedrückt"),
        // ---------------- Production & life ----------------
        "sfx_wood_chop": (files: ["sfx/wood_chop.ogg"], channel: Effects, volume: 0.5, max_instances: 2, pitch_variation: 0.08,
            description: "Axe chopping a tree, two strikes"),
        "sfx_tree_fall": (files: ["sfx/tree_fall.ogg"], channel: Effects, volume: 0.6, max_instances: 1,
            description: "Tree creaking and falling onto grass"),
        "sfx_saw": (files: ["sfx/sawmill.ogg"], channel: Effects, volume: 0.45, max_instances: 2,
            description: "Hand saw / water-powered saw cutting planks"),
        "sfx_stone_pick": (files: ["sfx/stone_pick.ogg"], channel: Effects, volume: 0.5, max_instances: 2, pitch_variation: 0.08,
            description: "Pickaxe striking stone in a quarry"),
        "sfx_anvil": (files: ["sfx/anvil.ogg"], channel: Effects, volume: 0.45, max_instances: 2, pitch_variation: 0.05,
            description: "Blacksmith hammer on anvil, three rhythmic strikes"),
        "sfx_mill": (files: ["sfx/windmill.ogg"], channel: Effects, volume: 0.4, max_instances: 1,
            description: "Windmill sails creaking and grinding stones"),
        "sfx_bakery": (files: ["sfx/bakery.ogg"], channel: Effects, volume: 0.4, max_instances: 1,
            description: "Oven fire crackle and dough being kneaded"),
        "sfx_brewery": (files: ["sfx/brewery.ogg"], channel: Effects, volume: 0.4, max_instances: 1,
            description: "Bubbling vats and wooden barrels"),
        "sfx_loom": (files: ["sfx/loom.ogg"], channel: Effects, volume: 0.4, max_instances: 1,
            description: "Wooden weaving loom clacking"),
        "sfx_kiln": (files: ["sfx/kiln.ogg"], channel: Effects, volume: 0.4, max_instances: 1,
            description: "Kiln or charcoal pile: low roar of a stoked fire, crackling embers, a shovel of fuel thrown in"),
        "sfx_workshop": (files: ["sfx/workshop.ogg"], channel: Effects, volume: 0.4, max_instances: 1, pitch_variation: 0.05,
            description: "Craft workshop: a hide scraped on a wooden beam, small mallet and chisel taps"),
        "sfx_bees": (files: ["sfx/bees.ogg"], channel: Effects, volume: 0.35, max_instances: 1,
            description: "Beehives: calm humming swarm, a wooden frame lifted out of a hive"),
        "sfx_mine": (files: ["sfx/mine.ogg"], channel: Effects, volume: 0.45, max_instances: 1,
            description: "Pickaxes echoing inside a mine, rocks falling into a cart"),
        "sfx_cow": (files: ["sfx/cow.ogg"], channel: Effects, volume: 0.45, cooldown_ms: 3000, pitch_variation: 0.08,
            description: "Single cow moo"),
        "sfx_sheep": (files: ["sfx/sheep.ogg"], channel: Effects, volume: 0.45, cooldown_ms: 3000, pitch_variation: 0.1,
            description: "Sheep bleating"),
        "sfx_chicken": (files: ["sfx/chicken.ogg"], channel: Effects, volume: 0.4, cooldown_ms: 3000, pitch_variation: 0.1,
            description: "Chickens clucking"),
        "sfx_church_bell": (files: ["sfx/church_bell.ogg"], channel: Effects, volume: 0.6, cooldown_ms: 20000,
            description: "Medieval church bell ringing three times"),
        "sfx_harvest": (files: ["sfx/harvest.ogg"], channel: Effects, volume: 0.6, cooldown_ms: 1500,
            description: "Scythe swishes through wheat, bundles being tied"),
        "sfx_fishing": (files: ["sfx/fishing.ogg"], channel: Effects, volume: 0.4, max_instances: 1,
            description: "Net splashing into water, small boat creak"),
        "sfx_cart": (files: ["sfx/cart.ogg"], channel: Effects, volume: 0.4, max_instances: 2,
            description: "Wooden cart wheels rolling on a dirt road, horse hooves"),
        "sfx_coins": (files: ["sfx/coins.ogg"], channel: Effects, volume: 0.7, cooldown_ms: 400,
            description: "Gold coins clinking into a purse"),
        // ---------------- Events ----------------
        "sfx_event_good": (files: ["sfx/event_good.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 1000,
            description: "Positive event fanfare: short bright horns (2 s)"),
        "sfx_event_bad": (files: ["sfx/event_bad.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 1000,
            description: "Negative event sting: low ominous horn and drum hit"),
        "sfx_fire": (files: ["sfx/fire.ogg"], channel: Effects, volume: 0.6, max_instances: 2,
            description: "Building on fire: roaring flames, crackling wood"),
        "sfx_alarm_bell": (files: ["sfx/alarm_bell.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 5000,
            description: "Urgent alarm bell ringing fast"),
        "sfx_war_horn": (files: ["sfx/war_horn.ogg"], channel: Effects, volume: 0.9, cooldown_ms: 3000,
            description: "Deep war horn blast"),
        "sfx_battle": (files: ["sfx/battle.ogg"], channel: Effects, volume: 0.7, max_instances: 1,
            description: "Distant battle: swords clashing, shouting, arrows"),
        "sfx_research_complete": (files: ["sfx/research_complete.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 1000,
            description: "Discovery: quill scratch then a warm magical chime"),
        "sfx_birth": (files: ["sfx/birth.ogg"], channel: Effects, volume: 0.5, cooldown_ms: 8000,
            description: "Gentle soft chime for a newborn (no crying)"),
        "sfx_death_bell": (files: ["sfx/death_bell.ogg"], channel: Effects, volume: 0.45, cooldown_ms: 10000,
            description: "Ein Bewohner ist gestorben: einzelner, ferner Schlag einer tiefen Totenglocke"),
        "sfx_wedding": (files: ["sfx/wedding.ogg"], channel: Effects, volume: 0.5, cooldown_ms: 8000,
            description: "Hochzeit: kurzes, fröhliches Glockenspiel mit zwei hellen Glocken"),
        "sfx_season_change": (files: ["sfx/season_change.ogg"], channel: Effects, volume: 0.7, cooldown_ms: 5000,
            description: "Seasonal transition: soft harp glissando"),
        "sfx_rank_up": (files: ["sfx/rank_up.ogg"], channel: Effects, volume: 0.9, cooldown_ms: 5000,
            description: "Royal fanfare for a new realm rank (4 s)"),
        "sfx_trade": (files: ["sfx/trade.ogg"], channel: Effects, volume: 0.7, cooldown_ms: 800,
            description: "Trade completed: coins + handshake-like wooden knock"),
        "sfx_event_pending": (files: ["sfx/event_pending.ogg"], channel: Effects, volume: 0.8, cooldown_ms: 2000,
            description: "Ein Ereignis verlangt eine Entscheidung: Pergament wird entrollt, kurzer Trommelwirbel"),
        "sfx_event_resolved": (files: ["sfx/event_resolved.ogg"], channel: Effects, volume: 0.7, cooldown_ms: 1000,
            description: "Entscheidung getroffen: Siegel wird in warmes Wachs gedrückt"),
        "sfx_flood": (files: ["sfx/flood.ogg"], channel: Effects, volume: 0.65, max_instances: 2,
            description: "Überschwemmung: rauschendes Wasser, das durch Gassen strömt, knarrendes Holz"),
        "sfx_storm_damage": (files: ["sfx/storm_damage.ogg"], channel: Effects, volume: 0.7, max_instances: 2,
            description: "Sturmschaden: heulende Böe, splitterndes Holz, herabfallende Dachschindeln"),
        "sfx_plague": (files: ["sfx/plague.ogg"], channel: Effects, volume: 0.5, cooldown_ms: 10000,
            description: "Seuche: gedämpftes Husten mehrerer Menschen, ferne Totenglocke"),
        "sfx_raid": (files: ["sfx/raid.ogg"], channel: Effects, volume: 0.75, cooldown_ms: 5000,
            description: "Räuberüberfall: raue Rufe, splitternde Kisten, davongaloppierende Pferde"),
        "sfx_deposit_found": (files: ["sfx/deposit_found.ogg"], channel: Effects, volume: 0.7, cooldown_ms: 3000,
            description: "Neues Vorkommen: Spitzhacke trifft hell klingend auf Erz, kurzer Glanzton"),
        // ---------------- War, diplomacy, caravans ----------------
        "sfx_war_drums": (files: ["sfx/war_drums.ogg"], channel: Effects, volume: 0.85, cooldown_ms: 5000,
            description: "Kriegserklärung: schwere Kriegstrommeln im langsamen Marschschritt, ein ferner Hornstoß (3 s)"),
        "sfx_victory": (files: ["sfx/victory.ogg"], channel: Effects, volume: 0.85, cooldown_ms: 4000,
