            description: "Karawane am Handelskontor: Glöckchen am Zaumzeug, knarrende Wagenräder, Esel schnaubt"),
        "sfx_wall_break": (files: ["sfx/wall_break.ogg"], channel: Effects, volume: 0.85, cooldown_ms: 2000, max_instances: 2,
            description: "Feinde brechen eine Mauer oder ein Tor auf: dumpfer Rammbockstoß, berstendes Holz, fallende Steine"),
        "sfx_drill": (files: ["sfx/drill.ogg"], channel: Effects, volume: 0.6, cooldown_ms: 3000,
