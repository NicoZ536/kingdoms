        // ---------------- Voice (German royal advisor) ----------------
        "vo_welcome": (files: ["voice/welcome.ogg"], channel: Voice, cooldown_ms: 2000,
            text: ["Majestät, willkommen in Eurem neuen Land. Möge Euer Reich gedeihen!"],
            description: "Royal advisor (mature male voice, German): warm and pleased"),
        "vo_building_complete": (files: ["voice/building_complete.ogg"], channel: Voice, cooldown_ms: 15000,
            text: ["Der Bau ist vollendet, Majestät."],
            description: "Royal advisor (mature male voice, German): warm and pleased"),
        "vo_food_shortage": (files: ["voice/food_shortage.ogg"], channel: Voice, cooldown_ms: 60000,
            text: ["Majestät, unsere Vorräte gehen zur Neige. Das Volk hungert!"],
            description: "Royal advisor (mature male voice, German): urgent and alarmed, but composed"),
        "vo_low_happiness": (files: ["voice/low_happiness.ogg"], channel: Voice, cooldown_ms: 60000,
            text: ["Das Volk ist unzufrieden, Majestät. Es murrt in den Gassen."],
            description: "Royal advisor (mature male voice, German): grave and subdued"),
        "vo_treasury_low": (files: ["voice/treasury_low.ogg"], channel: Voice, cooldown_ms: 60000,
            text: ["Die Schatzkammer ist beinahe leer, Majestät."],
            description: "Royal advisor (mature male voice, German): grave and subdued"),
        "vo_research_complete": (files: ["voice/research_complete.ogg"], channel: Voice, cooldown_ms: 10000,
