    (id: "sand",       name: "Sand",              category: Raw,    base_price: 2),
    (id: "wool",       name: "Wolle",             category: Raw,    base_price: 7),
    (id: "grain",      name: "Getreide (Gerste)", category: Raw,    base_price: 4),
    (id: "hides",      name: "Häute",             category: Raw,    base_price: 6),
    (id: "gold_ore",   name: "Golderz",           category: Raw,    base_price: 30),

